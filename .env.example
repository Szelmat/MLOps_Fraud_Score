# Copy to .env (ignored by Git):  cp .env.example .env
# docker compose reads it for the ${...} values in docker-compose.yaml.

# --- MinIO (S3-compatible store: DVC remote + MLflow artifacts) ---
# The password is secrets/minio_root_password.txt
MINIO_ROOT_USER=minioadmin
DVC_BUCKET=dvc
DVC_REMOTE=storage
MLFLOW_BUCKET=mlflow

# MLflow server -> MinIO; must match MINIO_ROOT_USER and secrets/minio_root_password.txt
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# --- PostgreSQL (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mlflow

# --- MLflow: http://localhost:5500 from the host (src/ml/config.py default) ---
MLFLOW_PORT=5500
